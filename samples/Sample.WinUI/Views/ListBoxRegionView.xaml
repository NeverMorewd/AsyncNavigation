<UserControl x:Class="Sample.WinUI.Views.ListBoxRegionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:an="using:AsyncNavigation.WinUI">
    <Grid Padding="20" ColumnDefinitions="220,*"><StackPanel Spacing="8"><TextBlock FontSize="24" Text="Custom ListBox region" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Command="{Binding GoBackCommand}" Content="Back" /><Button Command="{Binding GoForwardCommand}" Content="Forward" /></StackPanel><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="LightView" Content="Add light view" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="HeavyView" Content="Add heavy view" /></StackPanel><ListBox Grid.Column="1" Margin="12,0,0,0" an:RegionManager.RegionName="CustomListBoxRegion" /></Grid>
</UserControl>
