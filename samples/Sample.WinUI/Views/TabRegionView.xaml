<UserControl x:Class="Sample.WinUI.Views.TabRegionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:an="using:AsyncNavigation.WinUI">
    <Grid Padding="20" RowDefinitions="Auto,*"><ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"><StackPanel Orientation="Horizontal" Spacing="8"><Button Command="{Binding GoBackCommand}" Content="Back" /><Button Command="{Binding GoForwardCommand}" Content="Forward" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="LightView" Content="Light" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="HeavyView" Content="Heavy" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="HeavyView:Delay" Content="Heavy/delayed" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="LightView:New" Content="Light/new" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="HeavyView:New;Delay" Content="Heavy/new/delayed" /><Button Command="{Binding AsyncNavigateAndForgetCommand}" CommandParameter="LightView" Content="Light/forget" /><Button Command="{Binding AsyncNavigateAndForgetCommand}" CommandParameter="LightView:New" Content="Light/forget/new" /></StackPanel></ScrollViewer><TabView Grid.Row="1" Margin="0,12,0,0" an:RegionManager.PreferCache="True" an:RegionManager.RegionName="TabRegion" TabCloseRequested="OnTabCloseRequested" /></Grid>
</UserControl>
