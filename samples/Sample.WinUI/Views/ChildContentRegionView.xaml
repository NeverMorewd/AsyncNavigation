<UserControl x:Class="Sample.WinUI.Views.ChildContentRegionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:an="using:AsyncNavigation.WinUI">
    <Grid Padding="20" ColumnDefinitions="220,*"><StackPanel Spacing="8"><TextBlock FontSize="24" Text="Child content region" /><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding InstanceNumber}" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="LightView" Content="Light child" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="HeavyView" Content="Heavy child" /><Button Command="{Binding UnloadViewCommand}" CommandParameter="ChildContentRegionView" Content="Unload view" /></StackPanel><Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="DarkGreen" BorderThickness="1"><ContentControl an:RegionManager.RegionName="ChildContentRegion" /></Border></Grid>
</UserControl>
