<UserControl x:Class="Sample.WinUI.Views.HeavyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="DarkOrange"><ScrollViewer><StackPanel Margin="32" Spacing="10"><TextBlock FontSize="32" FontWeight="SemiBold" Text="{Binding Name}" /><StackPanel Orientation="Horizontal"><TextBlock FontSize="18" Text="Instance #" /><TextBlock FontSize="18" Text="{Binding InstanceNumber}" /></StackPanel><Button HorizontalAlignment="Left" Command="{Binding UnloadViewCommand}" CommandParameter="HeavyView" Content="Unload view" Visibility="{Binding IsDialog, Converter={StaticResource BoolToVisibilityInverted}}" /><Button HorizontalAlignment="Left" Command="{Binding CloseDialogCommand}" CommandParameter="HeavyView" Content="Close dialog" Visibility="{Binding IsDialog, Converter={StaticResource BoolToVisibility}}" /><ProgressBar IsIndeterminate="True" /><ItemsRepeater ItemsSource="{Binding HeavyItems}"><ItemsRepeater.ItemTemplate><DataTemplate><Border Margin="2" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox Width="70" /><CalendarDatePicker Width="150" /><TextBlock Text="Heavy item" /></StackPanel></Border></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater></StackPanel></ScrollViewer></Grid>
</UserControl>
