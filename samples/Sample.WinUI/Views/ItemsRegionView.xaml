<UserControl x:Class="Sample.WinUI.Views.ItemsRegionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:an="using:AsyncNavigation.WinUI">
    <Grid Padding="20" ColumnDefinitions="220,*"><StackPanel Spacing="8"><TextBlock FontSize="24" Text="Items region" /><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding InstanceNumber}" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="LightView" Content="Add light view" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="HeavyView" Content="Add heavy view" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="HeavyView:Delay" Content="Add delayed heavy view" /><Button Command="{Binding AsyncNavigateCommand}" CommandParameter="HeavyView:Error" Content="Add error view" /><Button Command="{Binding AsyncNavigateAndForgetCommand}" CommandParameter="LightView" Content="Add light (forget)" /><Button Command="{Binding UnloadViewCommand}" CommandParameter="ItemsRegionView" Content="Unload view" /></StackPanel><ScrollViewer Grid.Column="1"><ListView an:RegionManager.RegionName="ItemsRegion" SelectionMode="Single" /></ScrollViewer></Grid>
</UserControl>
