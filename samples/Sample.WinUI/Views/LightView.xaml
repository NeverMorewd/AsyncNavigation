<UserControl x:Class="Sample.WinUI.Views.LightView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="CadetBlue"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><TextBlock FontSize="32" FontWeight="SemiBold" Text="{Binding Name}" /><StackPanel Orientation="Horizontal"><TextBlock FontSize="18" Text="Instance #" /><TextBlock FontSize="18" Text="{Binding InstanceNumber}" /></StackPanel><Button HorizontalAlignment="Center" Command="{Binding UnloadViewCommand}" CommandParameter="LightView" Content="Unload view" Visibility="{Binding IsDialog, Converter={StaticResource BoolToVisibilityInverted}}" /><Button HorizontalAlignment="Center" Command="{Binding CloseDialogCommand}" CommandParameter="LightView" Content="Close dialog" Visibility="{Binding IsDialog, Converter={StaticResource BoolToVisibility}}" /><Button HorizontalAlignment="Center" Command="{Binding CloseDialogWithCancellingCommand}" CommandParameter="LightView" Content="Close dialog (cancel after 2s)" Visibility="{Binding IsDialog, Converter={StaticResource BoolToVisibility}}" /></StackPanel></Grid>
</UserControl>
